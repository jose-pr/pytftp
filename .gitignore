# Dotfiles are local by default; re-include the ones that are shared.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Agent configs / private notes -- never tracked in this repo.
# `.agents` is deliberately slashless: it is usually a symlink, which a
# directory-only `.agents/` pattern would not match.
.agents
*.local.*
CLAUDE*
.claude

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
*.egg-info/
.venv/
.pyvenv/

# Build / docs output
build/
dist/
site/
